{
  "name": "bitplay-frontend",
  "private": true,
  "scripts": {
    "dev": "yarn intl && yarn content:worker:start & cross-env NODE_OPTIONS='--inspect' next --turbopack",
    "build": "yarn intl && next build",
    "build:bundle": "cross-env ANALYZE=true next build",
    "intl:extract": "formatjs extract \"(app||pages)/**/*.ts(|x)\" --out-file app/lang/extracted/en.json --id-interpolation-pattern \"[sha512:contenthash:base64:6]\" --ignore \"(app||pages)/**/*d.ts\"",
    "intl:compile": "formatjs compile-folder app/lang/extracted app/lang/compiled --ast",
    "intl": "yarn intl:extract && yarn intl:compile",
    "start": "yarn content:prebuild && yarn content:worker:start & next start",
    "start:with-cache": "yarn content:worker:start & next start",
    "lint": "eslint . --max-warnings=10 --fix && stylelint \"app/**/*.styles.ts\"",
    "lint:types": "tsc --noemit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --quiet",
    "test": "cross-env NODE_ENV=test jest",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "format": "prettier --write \"app/**/*.{js,jsx,ts,tsx,html,css,scss}\" \"pages/**/*.{js,jsx,ts,tsx,html,css,scss}\" \"types/**/*.{js,jsx,ts,tsx,html,css,scss}\"",
    "deploy": "yarn format && yarn build && yarn start",
    "prepare": "husky",
    "sitemap": "next-sitemap --config sitemap.config.js",
    "content:prebuild": "node contentmanager.js",
    "content:worker:start": "node content-worker-service.js",
    "content:worker:dev": "cross-env CONTENT_UPDATE_INTERVAL=300000 node content-worker-service.js",
    "content:update": "node contentmanager.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^2.8.5",
    "@next/bundle-analyzer": "^15.2.4",
    "@reduxjs/toolkit": "^1.8.5",
    "axios": "^1.2.4",
    "bignumber.js": "^9.1.0",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^8.2.0",
    "js-cookie": "^2.2.1",
    "jwt-decode": "^3.0.0",
    "lodash": "^4.17.21",
    "next": "15.2.3",
    "next-auth": "^4.22.1",
    "next-redux-wrapper": "^8.0.0",
    "react": "^18.3.1",
    "react-cookie": "^4.1.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.22.1",
    "react-imask": "^7.6.1",
    "react-intl": "^7.0.1",
    "react-qr-code": "^2.0.7",
    "react-redux": "^8.0.2",
    "react-select": "^5.3.0",
    "react-slick": "^0.29.0",
    "react-use-intercom": "^5.1.4",
    "redux": "^4.2.0",
    "slick-carousel": "^1.8.1",
    "styled-components": "^6.1.13",
    "stylis": "^4.0.0",
    "uuid": "^11.0.3",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@babel/core": "^7.12.10",
    "@chromatic-com/storybook": "^3",
    "@formatjs/cli": "^6.3.11",
    "@storybook/addon-actions": "^8.4.6",
    "@storybook/addon-essentials": "^8.4.6",
    "@storybook/addon-links": "^8.4.6",
    "@storybook/nextjs": "^8.4.6",
    "@storybook/react": "^8.4.6",
    "@svgr/webpack": "^6.2.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/js-cookie": "^2.2.6",
    "@types/jwt-decode": "^2.2.1",
    "@types/lodash": "^4.17.13",
    "@types/lodash.assignin": "^4.2.6",
    "@types/node": "^18.7.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/react-intl": "^3.0.0",
    "@types/react-select": "^5.0.1",
    "@types/react-slick": "^0.23.8",
    "@types/uuid": "^10.0.0",
    "@types/webpack-env": "^1.15.2",
    "@typescript-eslint/eslint-plugin": "^5.30.5",
    "@typescript-eslint/parser": "^5.30.5",
    "axios-mock-adapter": "^1.20.0",
    "babel-loader": "^9.2.1",
    "babel-plugin-formatjs": "^10.5.26",
    "babel-plugin-inline-react-svg": "^2.0.2",
    "eslint": "^8.0.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-next": "^13.2.4",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-modules-newline": "^0.0.6",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.22.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-webpack-plugin": "^2.5.0",
    "husky": "^9.1.7",
    "jest": "^26.6.3",
    "jest-junit": "^13.0.0",
    "jest-styled-components": "^7.2.0",
    "lint-staged": "^10.5.4",
    "lodash.assignin": "^4.2.0",
    "mockdate": "^3.0.5",
    "next-router-mock": "^0.6.3",
    "next-sitemap": "^4.2.3",
    "prettier": "^2.7.1",
    "storybook": "^8.4.6",
    "stylelint": "^13.3.3",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-standard": "^20.0.0",
    "stylelint-config-styled-components": "^0.1.1",
    "stylelint-order": "^4.0.0",
    "stylelint-processor-styled-components": "^1.10.0",
    "typescript": "^5",
    "webpack": "5"
  },
  "lint-staged": {
    "*.js": [
      "yarn eslint",
      "yarn stylelint \"app/**/*.js\"",
      "yarn test --bail --findRelatedTests"
    ],
    "*.jsx": [
      "yarn eslint",
      "yarn stylelint \"app/**/*.jsx\"",
      "yarn test --bail --findRelatedTests"
    ],
    "*.ts": [
      "yarn eslint",
      "yarn stylelint \"app/**/*.ts\"",
      "yarn test --bail --findRelatedTests"
    ],
    "*.tsx": [
      "yarn eslint",
      "yarn stylelint \"app/**/*.tsx\"",
      "yarn test --bail --findRelatedTests"
    ]
  },
  "browserslist": [
    ">0.3%",
    "chrome 64",
    "edge 79",
    "firefox 67",
    "opera 51",
    "safari 12",
    "ios 12.2"
  ],
  "packageManager": "yarn@1.22.22"
}
